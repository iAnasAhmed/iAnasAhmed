# ---------------------------------------------------------------------------
# Ayat Fahiem Cosmetics - Meta Ads Command Centre
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# System User token from Business Manager (ayatfahiemcosmetics, id 7587342798035629).
# Needs scopes: ads_read, business_management.
# Business Settings > Users > System Users > Generate New Token.
META_ACCESS_TOKEN=

# Primary ad account. Numeric, no "act_" prefix.
# 1119657799748776 = Anas_cosmetics  (the live cosmetics account, EGP)
META_AD_ACCOUNT_ID=1119657799748776

# Optional secondary accounts to track, comma separated.
META_EXTRA_AD_ACCOUNTS=660617751508124

# Conversions pixel / dataset used for the shop.
META_PIXEL_ID=3096031973908285

# Graph API version.
META_API_VERSION=v23.0

# --- Business economics: these drive the mentor's verdicts. Update them. -----
# Gross margin on a typical order (0.55 = 55% margin after COGS + shipping).
BUSINESS_GROSS_MARGIN=0.55
# Target return on ad spend. Break-even ROAS = 1 / margin (1/0.55 = 1.82).
TARGET_ROAS=4.0
# Target cost per website purchase, in account currency (EGP).
TARGET_CPA=220
# Average order value, in account currency. Leave blank to derive from live data.
AVERAGE_ORDER_VALUE=
# Monthly ad budget you are planning around (EGP).
MONTHLY_BUDGET=70000

# --- Runtime ---------------------------------------------------------------
PORT=4300
# Minutes between automatic live syncs.
SYNC_INTERVAL_MINUTES=15
# Set to 1 to run a sync the moment the server boots.
SYNC_ON_BOOT=1
