{
  "name": "ayat-points",
  "version": "0.1.0",
  "private": true,
  "description": "Loyalty points service for Ayat Fahiem Cosmetics - awards points to Judge.me verified buyers and redeems them as Shopify discount codes.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute ayat-points --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute ayat-points --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
